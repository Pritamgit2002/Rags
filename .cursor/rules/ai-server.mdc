## Transport 2 — Socket.IO (mobile / React Native)

### Server: attach Socket.IO to the Express HTTP server

```ts
// src/app.ts
import express from "express";
import { createServer } from "http";
import { Server as SocketIOServer } from "socket.io";
import { register_socket_handlers } from "@/socket";

export function createApp() {
  const app = express();
  const server = createServer(app);
  const io = new SocketIOServer(server, {
    cors: { origin: "*", methods: ["GET", "POST"] },
  });

  // mount REST routes
  app.use("/chats", chat_router);
  app.use("/agents", agent_router);

  // attach Socket.IO handlers
  register_socket_handlers(io);

  return server; // return the http.Server, not app
}
```

```ts
// src/index.ts  — listen on the http.Server, not app
const server = createApp();
server.listen(port, () => console.log(`✓ [server] http://localhost:${port}`));
```

### Server: Socket.IO handler — mirrors the SSE controller

```ts
// src/socket/index.ts
import { Server, Socket } from "socket.io";
import { verify_firebase_token } from "@/middleware/verify-token";
import { run_chat_completion } from "@/services/chat-completion";

export function register_socket_handlers(io: Server) {
  // auth handshake — verify Firebase token from socket.handshake.auth
  io.use(async (socket, next) => {
    const token = socket.handshake.auth?.token as string | undefined;
    if (!token) return next(new Error("Unauthorized"));
    try {
      socket.data.firebase_user = await verify_firebase_token(token);
      next();
    } catch {
      next(new Error("Unauthorized"));
    }
  });

  io.on("connection", (socket: Socket) => {
    socket.on(
      "chat:completion",
      async (payload: {
        conversation_id: string;
        prompt: string;
        user_files?: unknown[];
      }) => {
        const { conversation_id, prompt, user_files } = payload;
        const { uid } = socket.data.firebase_user;

        await run_chat_completion({
          conversation_id,
          user_id: uid,
          prompt,
          user_files,
          emitters: {
            on_validated: () =>
              socket.emit("chat:validated", { conversation_id }),
            on_title: (title) => socket.emit("chat:title", { title }),
            on_text_delta: (text) => socket.emit("chat:text-delta", { text }),
            on_thinking_delta: (text) =>
              socket.emit("chat:thinking-delta", { text }),
            on_tool_call: (e) => socket.emit("chat:tool-call", e),
            on_tool_result: (e) => socket.emit("chat:tool-result", e),
            on_status: (text) => socket.emit("chat:status", { text }),
            on_complete: (id) =>
              socket.emit("chat:complete", { conversation_id: id }),
            on_error: (msg) => socket.emit("chat:error", { message: msg }),
          },
        });
      }
    );
  });
}
```

**Rules:**

- Socket.IO auth middleware runs on every connection — validate the Firebase token in `io.use()`, never inside the event handler
- Emit events with a `chat:` namespace prefix to avoid collisions with Socket.IO system events
- The emitters object passed to `run_chat_completion` is structurally identical — only the transport differs
- Never call `socket.disconnect()` after `on_complete` — the client manages the connection lifecycle

### Client: consuming Socket.IO in React Native (app)

```ts
// apps/app/src/hooks/use-chat-socket.ts
import { io, Socket } from "socket.io-client";

let socket: Socket | null = null;

export function useChatSocket() {
  const connect = async () => {
    const token = await firebase_auth.currentUser?.getIdToken();

    socket = io(process.env.EXPO_PUBLIC_AI_URL!, {
      auth: { token }, // sent in handshake, verified by io.use()
      transports: ["websocket"], // skip long-polling for mobile
      reconnection: true,
      reconnectionAttempts: 5,
    });

    socket.on("connect", () => console.log("socket connected"));
    socket.on("disconnect", (r) => console.log("socket disconnected", r));
    socket.on("connect_error", (e) => console.error("socket error", e.message));
  };

  const send_completion = (conversation_id: string, prompt: string) => {
    socket?.emit("chat:completion", { conversation_id, prompt });
  };

  const subscribe = (handlers: {
    on_validated?: (d: { conversation_id: string }) => void;
    on_title?: (d: { title: string }) => void;
    on_text_delta?: (d: { text: string }) => void;
    on_thinking_delta?: (d: { text: string }) => void;
    on_status?: (d: { text: string }) => void;
    on_complete?: (d: { conversation_id: string }) => void;
    on_error?: (d: { message: string }) => void;
  }) => {
    if (!socket) return;
    socket.on("chat:validated", handlers.on_validated ?? (() => {}));
    socket.on("chat:title", handlers.on_title ?? (() => {}));
    socket.on("chat:text-delta", handlers.on_text_delta ?? (() => {}));
    socket.on("chat:thinking-delta", handlers.on_thinking_delta ?? (() => {}));
    socket.on("chat:status", handlers.on_status ?? (() => {}));
    socket.on("chat:complete", handlers.on_complete ?? (() => {}));
    socket.on("chat:error", handlers.on_error ?? (() => {}));
  };

  const disconnect = () => {
    socket?.disconnect();
    socket = null;
  };

  return { connect, send_completion, subscribe, disconnect };
}
```


# ============================================================
# Root environment variables — copy to .env and fill in values
# All apps and packages read from this single file.
# ============================================================

# Database (packages/db)
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Crud API (apps/crud)
CRUD_PORT=8000

# Cloudflare R2 (apps/crud)
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=your_bucket_name
# R2_PUBLIC_URL=https://your-bucket.your-domain.com

# Next.js (apps/web)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Exa
EXA_API_KEY=your_exa_api_key

# Supabase — apps/web (public) + apps/crud (service role)
# Get these from: https://supabase.com/dashboard/project/<project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI — chat, embeddings, and document OCR (gpt-5-mini + text-embedding-3-small)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Discord Incoming Webhook (server-side only, never client-side)
# Create at: Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
